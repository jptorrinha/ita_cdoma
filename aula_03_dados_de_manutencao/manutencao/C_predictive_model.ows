		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x015\x00\x00\x00\x1f\x00\x00\x06\r\x00\x00\x03\xe2\x00\x00\x015\x00\x00\x00;\x00\x00\x06\r\x00\x00\x03\xe2\x00\x00\x00\x00\x00\x00\x00\x00\x06\x90\x00\x00\x015\x00\x00\x00;\x00\x00\x06\r\x00\x00\x03\xe2', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\nfrom sklearn.model_selection import train_test_split\n\n# Convert Orange Table to pandas DataFrame\ndf = table_to_frame(in_data, include_metas=True)\n\n# Get the Type column for stratification\ntype_column = df[\'Type\']\n\n# Perform stratified split: 70% train, 30% test\n# random_state=0 to match Jupyter notebook\ntrain_df, test_df = train_test_split(\n    df,\n    test_size=0.3,\n    random_state=0,\n    stratify=type_column\n)\n\n# Convert back to Orange Tables\nout_data = table_from_frame(train_df)  # 70% for training\nout_object = table_from_frame(test_df)  # 30% for testing (holdout)\n\n# Set "Machine failure" as the target variable for both tables\n# Find the "Machine failure" attribute in the domain\nfor table in [out_data, out_object]:\n      if "failures" in table.domain:\n          # Get current domain\n          old_domain = table.domain\n\n          # Find the Machine failure variable\n          machine_failure_var = old_domain["failures"]\n\n          # Create new domain with Machine failure as class variable\n          attributes = [var for var in old_domain.attributes if var.name != "failures"]\n          class_var = machine_failure_var\n          metas = old_domain.metas\n\n          new_domain = Domain(attributes, class_var, metas)\n\n          # Transform the table to use new domain\n          if table is out_data:\n              out_data = table.transform(new_domain)\n          else:\n              out_object = table.transform(new_domain)', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\nnew_assets = table_to_frame(in_data, include_metas=True)\nclassifier = in_object\n\nrename_map = {\n    column: column.replace("_Quantity_sum", "")\n    for column in new_assets.columns\n    if column.endswith("_Quantity_sum")\n}\nrename_map.update({"Time_begin_exploitation": "Time - Min. value"})\n\nnew_assets_model = new_assets.rename(columns=rename_map).copy()\nnew_assets_model["Use - Min. value"] = 0.0\n\nfeatures = [\n    "Time - Min. value",\n    "Use - Min. value",\n    "nb_km",\n    "R193", "R364", "R417", "R446", "R565", "R707", "R783",\n]\nmissing_features = [f for f in features if f not in new_assets_model.columns]\nif missing_features:\n    raise ValueError(f"Atributos ausentes nos novos ativos: {missing_features}")\n\nnew_probability = classifier.predict_proba(new_assets_model[features])[:, 1]\n\nranking = (\n    pd.DataFrame({\n        "Asset": new_assets_model["Asset"],\n        "probabilidade_falha": new_probability,\n        "classe_limiar_0_50": (new_probability &gt;= 0.50).astype(int),\n    })\n    .sort_values("probabilidade_falha", ascending=False)\n    .reset_index(drop=True)\n)\n\nprint(f"Novos ativos avaliados: {len(ranking)}")\nprint(f"Acima do limiar 0,50: {ranking[\'classe_limiar_0_50\'].sum()}")\nprint(ranking.head(10).to_string())\n\nout_data = table_from_frame(ranking)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x02K\x00\x00\x01D\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
