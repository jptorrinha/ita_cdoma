		<properties node_id="1" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xae\x00\x00\x00\xdf\x00\x00\x04\xcd\x00\x00\x02\xee\x00\x00\x01\xae\x00\x00\x00\xfb\x00\x00\x04\xcd\x00\x00\x02\xee\x00\x00\x00\x00\x00\x00\x00\x00\x06\x90\x00\x00\x01\xae\x00\x00\x00\xfb\x00\x00\x04\xcd\x00\x00\x02\xee', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="2" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x015\x00\x00\x00 \x00\x00\x06\r\x00\x00\x03\xfb\x00\x00\x015\x00\x00\x00E\x00\x00\x06\r\x00\x00\x03\xfb\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x015\x00\x00\x00E\x00\x00\x06\r\x00\x00\x03\xfb', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\nfrom sklearn.model_selection import train_test_split\n\n# Convert Orange Table to pandas DataFrame\ndf = table_to_frame(in_data, include_metas=True)\n\n# Get the Type column for stratification\ntype_column = df[\'Type\']\n\n# Perform stratified split: 70% train, 30% test\n# random_state=0 to match Jupyter notebook\ntrain_df, test_df = train_test_split(\n    df,\n    test_size=0.3,\n    random_state=0,\n    stratify=type_column\n)\n\n# Convert back to Orange Tables\nout_data = table_from_frame(train_df)  # 70% for training\nout_object = table_from_frame(test_df)  # 30% for testing (holdout)\n\n# Set "Machine failure" as the target variable for both tables\n# Find the "Machine failure" attribute in the domain\nfor table in [out_data, out_object]:\n      if "failures" in table.domain:\n          # Get current domain\n          old_domain = table.domain\n\n          # Find the Machine failure variable\n          machine_failure_var = old_domain["failures"]\n\n          # Create new domain with Machine failure as class variable\n          attributes = [var for var in old_domain.attributes if var.name != "failures"]\n          class_var = machine_failure_var\n          metas = old_domain.metas\n\n          new_domain = Domain(attributes, class_var, metas)\n\n          # Transform the table to use new domain\n          if table is out_data:\n              out_data = table.transform(new_domain)\n          else:\n              out_object = table.transform(new_domain)', 'filename': None}], 'scriptText': 'import sys\nsys.path.insert(0, r"/Users/joao/Documents/Documentos - MacBook Pro de Joao/ITA/code/ita_cdoma/aula_03_dados_de_manutencao/manutencao/.orange_pylibs")\n\nimport numpy as np\nimport pandas as pd\nimport lightgbm as lgb\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import (\n    accuracy_score, confusion_matrix, precision_score, recall_score,\n)\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\n# Atributos de uso ("Time - Min. value" / "Use - Min. value" sao os nomes\n# que o Group By do B_usage_data.ows da a Time_min/Use_min) e de consumo\n# (mesmo subconjunto de 7 motivos da versao original do notebook C).\nfeatures = [\n    "Time - Min. value",\n    "Use - Min. value",\n    "nb_km",\n    "R193", "R364", "R417", "R446", "R565", "R707", "R783",\n]\ntarget = "failure_bin"\n\nlabeled = df.loc[df[target].notna()].copy()\nX = labeled[features]\ny = labeled[target].astype(int)\n\nprint(f"Ativos com rotulo: {len(labeled):,}")\nprint(f"Ativos sem rotulo: {df[target].isna().sum():,}")\nprint(f"Taxa de falha: {y.mean():.2%}")\nprint(f"Valores ausentes nos atributos: {X.isna().sum().sum():,}")\n\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.30, random_state=42, stratify=y,\n)\n\nclassifier = lgb.LGBMClassifier(\n    learning_rate=0.05,\n    n_estimators=200,\n    num_leaves=31,\n    max_bin=125,\n    importance_type="gain",\n    random_state=42,\n    verbose=-1,\n)\nclassifier.fit(X_train, y_train)\n\ny_probability = classifier.predict_proba(X_test)[:, 1]\ny_pred = (y_probability &gt;= 0.50).astype(int)\n\ntn, fp, fn, tp = confusion_matrix(y_test, y_pred, labels=[0, 1]).ravel()\n\nprint(f"\\nTreino: {len(X_train):,} ativos; falhas = {y_train.mean():.2%}")\nprint(f"Teste:  {len(X_test):,} ativos; falhas = {y_test.mean():.2%}")\nprint(f"\\nAcuracia: {accuracy_score(y_test, y_pred):.1%}")\nprint(f"Precisao: {precision_score(y_test, y_pred, zero_division=0):.1%}")\nprint(f"Recall:   {recall_score(y_test, y_pred):.1%}")\nprint(f"TN={tn} | FP={fp} | FN={fn} | TP={tp}")\n\nimportance = (\n    pd.Series(classifier.feature_importances_, index=features)\n    .sort_values(ascending=False)\n)\nprint("\\nImportancia dos atributos (ganho acumulado):")\nprint(importance.to_string())\n\ntest_out = X_test.copy()\ntest_out["Asset"] = labeled.loc[X_test.index, "Asset"]\ntest_out["failure_bin_real"] = y_test.values\ntest_out["probabilidade_falha"] = y_probability\ntest_out["previsto_0_50"] = y_pred\ntest_out = test_out.reset_index(drop=True)\n\nout_data = table_from_frame(test_out)\nout_object = classifier\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x02K\x00\x00\x01D\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
