		<properties node_id="8" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x91\x00\x00\x00\x05\x00\x00\x05q\x00\x00\x03r\x00\x00\x00\x92\x00\x00\x00#\x00\x00\x05p\x00\x00\x03q\x00\x00\x00\x00\x00\x00\x00\x00\x06\xab\x00\x00\x00\x92\x00\x00\x00#\x00\x00\x05p\x00\x00\x03q', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\n\n# Gerador aleatório com semente fixa (42).\n# A mesma semente produz o mesmo resultado em toda execução:\n# útil para aula, relatório e comparação entre alunos.\nrng = np.random.default_rng(42)\n\n# in_data.Y são os rótulos (Target), no seu caso FailureMode.\n# ravel() achata o vetor para 1D, no formato que o NumPy espera.\ny = np.asarray(in_data.Y).ravel()\n\n# classes: valores únicos (N01, N02, F01, ..., F06)\n# counts:  quantas linhas existem em cada classe\nclasses, counts = np.unique(y, return_counts=True)\n\n# LIMIAR: tamanho mínimo desejado para uma classe "pequena".\n# Só as classes com MENOS de 50 linhas serão aumentadas.\nLIMIAR = 50\n\n# Trava de segurança: uma classe nunca cresce mais que 5 vezes.\n# Exemplo: 8 linhas → no máximo 40, mesmo que o limiar seja 50.\n# Evita explodir classes minúsculas com dezenas de cópias idênticas.\nMAX_MULTIPLICADOR = 5\n\n# Começa com TODAS as linhas originais (índices 0, 1, 2, ..., n-1).\n# As cópias das classes raras serão acrescentadas depois.\nselected = np.arange(len(in_data)).tolist()\n\n# Percorre cada classe e decide se precisa de oversampling.\nfor class_value, count in zip(classes, counts):\n\n    # Classe já tem tamanho suficiente: não altera nada.\n    if count &gt;= LIMIAR:\n        continue\n\n    # Índices das linhas que pertencem a esta classe rara.\n    class_indices = np.flatnonzero(y == class_value)\n\n    # Alvo = o menor entre:\n    #   - chegar a 50 linhas, ou\n    #   - multiplicar a classe por no máximo 5.\n    alvo = min(LIMIAR, count * MAX_MULTIPLICADOR)\n\n    # Quantas cópias ainda faltam para chegar ao alvo.\n    faltam = int(alvo - count)\n\n    if faltam &gt; 0:\n        # Sorteia "faltam" índices ENTRE as linhas já existentes\n        # desta classe, COM REPOSIÇÃO (replace=True).\n        # A mesma linha pode ser escolhida várias vezes:\n        # isso é duplicação, não criação de dado novo.\n        extra = rng.choice(class_indices, size=faltam, replace=True)\n\n        # Acrescenta as linhas duplicadas à lista final.\n        selected.extend(extra.tolist())\n\n# Embaralha a ordem das linhas.\n# Sem isso, as cópias ficariam agrupadas no fim da tabela\n# e o aluno veria um bloco artificial de exemplos repetidos.\nrng.shuffle(selected)\n\n# Constrói a tabela de saída do widget com as linhas selecionadas\n# (originais + duplicatas das classes raras).\nout_data = in_data[selected]\n\n# Conferência rápida no log do widget:\n# quantas linhas havia em cada classe e quantas há depois.\nprint("Antes:", dict(zip(classes, counts)))\nprint("Depois:", dict(zip(*np.unique(out_data.Y, return_counts=True))))', 'filename': None}], 'scriptText': 'import numpy as np\n\n# Gerador aleatório com semente fixa (42).\n# A mesma semente produz o mesmo resultado em toda execução:\n# útil para aula, relatório e comparação entre alunos.\nrng = np.random.default_rng(42)\n\n# in_data.Y são os rótulos (Target), no seu caso FailureMode.\n# ravel() achata o vetor para 1D, no formato que o NumPy espera.\ny = np.asarray(in_data.Y).ravel()\n\n# classes: valores únicos (N01, N02, F01, ..., F06)\n# counts:  quantas linhas existem em cada classe\nclasses, counts = np.unique(y, return_counts=True)\n\n# LIMIAR: tamanho mínimo desejado para uma classe "pequena".\n# Só as classes com MENOS de 50 linhas serão aumentadas.\nLIMIAR = 50\n\n# Trava de segurança: uma classe nunca cresce mais que 5 vezes.\n# Exemplo: 8 linhas → no máximo 40, mesmo que o limiar seja 50.\n# Evita explodir classes minúsculas com dezenas de cópias idênticas.\nMAX_MULTIPLICADOR = 5\n\n# Começa com TODAS as linhas originais (índices 0, 1, 2, ..., n-1).\n# As cópias das classes raras serão acrescentadas depois.\nselected = np.arange(len(in_data)).tolist()\n\n# Percorre cada classe e decide se precisa de oversampling.\nfor class_value, count in zip(classes, counts):\n\n    # Classe já tem tamanho suficiente: não altera nada.\n    if count &gt;= LIMIAR:\n        continue\n\n    # Índices das linhas que pertencem a esta classe rara.\n    class_indices = np.flatnonzero(y == class_value)\n\n    # Alvo = o menor entre:\n    #   - chegar a 50 linhas, ou\n    #   - multiplicar a classe por no máximo 5.\n    alvo = min(LIMIAR, count * MAX_MULTIPLICADOR)\n\n    # Quantas cópias ainda faltam para chegar ao alvo.\n    faltam = int(alvo - count)\n\n    if faltam &gt; 0:\n        # Sorteia "faltam" índices ENTRE as linhas já existentes\n        # desta classe, COM REPOSIÇÃO (replace=True).\n        # A mesma linha pode ser escolhida várias vezes:\n        # isso é duplicação, não criação de dado novo.\n        extra = rng.choice(class_indices, size=faltam, replace=True)\n\n        # Acrescenta as linhas duplicadas à lista final.\n        selected.extend(extra.tolist())\n\n# Embaralha a ordem das linhas.\n# Sem isso, as cópias ficariam agrupadas no fim da tabela\n# e o aluno veria um bloco artificial de exemplos repetidos.\nrng.shuffle(selected)\n\n# Constrói a tabela de saída do widget com as linhas selecionadas\n# (originais + duplicatas das classes raras).\nout_data = in_data[selected]\n\n# Conferência rápida no log do widget:\n# quantas linhas havia em cada classe e quantas há depois.\nprint("Antes:", dict(zip(classes, counts)))\nprint("Depois:", dict(zip(*np.unique(out_data.Y, return_counts=True))))', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x02K\x00\x00\x01D\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
