		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x91\x00\x00\x00\x10\x00\x00\x05q\x00\x00\x03o\x00\x00\x00\x92\x00\x00\x00.\x00\x00\x05p\x00\x00\x03n\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x92\x00\x00\x00.\x00\x00\x05p\x00\x00\x03n', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data.pandas_compat import table_to_frame\nfrom sklearn.model_selection import GroupShuffleSplit\n\ndf = table_to_frame(in_data, include_metas=True).reset_index(drop=True)\n\ny = df["FailureMode"].astype(str)\ngroups = df["SN"].astype(str)\nclasses = sorted(y.unique())\n\n# Distribuição original das classes\noriginal_distribution = (\n    y.value_counts(normalize=True)\n    .reindex(classes, fill_value=0)\n)\n\n# Gera várias divisões por SN e escolhe a mais bem estratificada\nsplitter = GroupShuffleSplit(\n    n_splits=2000,\n    test_size=0.30,\n    random_state=0,\n)\n\nbest_score = np.inf\nbest_split = None\n\nfor train_index, test_index in splitter.split(df, y, groups):\n    y_train = y.iloc[train_index]\n    y_test = y.iloc[test_index]\n\n    # Exige todas as oito classes nos dois conjuntos\n    if set(y_train.unique()) != set(classes):\n        continue\n    if set(y_test.unique()) != set(classes):\n        continue\n\n    train_distribution = (\n        y_train.value_counts(normalize=True)\n        .reindex(classes, fill_value=0)\n    )\n    test_distribution = (\n        y_test.value_counts(normalize=True)\n        .reindex(classes, fill_value=0)\n    )\n\n    score = (\n        (train_distribution - original_distribution).abs().sum()\n        + (test_distribution - original_distribution).abs().sum()\n        + abs(len(test_index) / len(df) - 0.30)\n    )\n\n    if score &lt; best_score:\n        best_score = score\n        best_split = train_index, test_index\n\nif best_split is None:\n    raise ValueError("Não foi possível criar uma divisão contendo todas as classes.")\n\ntrain_index, test_index = best_split\n\n# Preserva domínio, target e metadados definidos no Select Columns\nout_data = in_data[train_index]\nout_object = in_data[test_index]\n\n# Verificação\ntrain_sn = set(groups.iloc[train_index])\ntest_sn = set(groups.iloc[test_index])\n\nprint(f"Treino: {len(train_index)} movimentos")\nprint(f"Teste:  {len(test_index)} movimentos")\nprint(f"SN presentes nos dois conjuntos: {train_sn &amp; test_sn}")\n\nprint("\\nClasses no treino:")\nprint(y.iloc[train_index].value_counts().sort_index())\n\nprint("\\nClasses no teste:")\nprint(y.iloc[test_index].value_counts().sort_index())', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data.pandas_compat import table_to_frame\nfrom sklearn.model_selection import GroupShuffleSplit\n\ndf = table_to_frame(in_data, include_metas=True).reset_index(drop=True)\n\ny = df["FailureMode"].astype(str)\ngroups = df["SN"].astype(str)\nclasses = sorted(y.unique())\n\n# Distribuição original das classes\noriginal_distribution = (\n    y.value_counts(normalize=True)\n    .reindex(classes, fill_value=0)\n)\n\n# Gera várias divisões por SN e escolhe a mais bem estratificada\nsplitter = GroupShuffleSplit(\n    n_splits=2000,\n    test_size=0.30,\n    random_state=0,\n)\n\nbest_score = np.inf\nbest_split = None\n\nfor train_index, test_index in splitter.split(df, y, groups):\n    y_train = y.iloc[train_index]\n    y_test = y.iloc[test_index]\n\n    # Exige todas as oito classes nos dois conjuntos\n    if set(y_train.unique()) != set(classes):\n        continue\n    if set(y_test.unique()) != set(classes):\n        continue\n\n    train_distribution = (\n        y_train.value_counts(normalize=True)\n        .reindex(classes, fill_value=0)\n    )\n    test_distribution = (\n        y_test.value_counts(normalize=True)\n        .reindex(classes, fill_value=0)\n    )\n\n    score = (\n        (train_distribution - original_distribution).abs().sum()\n        + (test_distribution - original_distribution).abs().sum()\n        + abs(len(test_index) / len(df) - 0.30)\n    )\n\n    if score &lt; best_score:\n        best_score = score\n        best_split = train_index, test_index\n\nif best_split is None:\n    raise ValueError("Não foi possível criar uma divisão contendo todas as classes.")\n\ntrain_index, test_index = best_split\n\n# Preserva domínio, target e metadados definidos no Select Columns\nout_data = in_data[train_index]\nout_object = in_data[test_index]\n\n# Verificação\ntrain_sn = set(groups.iloc[train_index])\ntest_sn = set(groups.iloc[test_index])\n\nprint(f"Treino: {len(train_index)} movimentos")\nprint(f"Teste:  {len(test_index)} movimentos")\nprint(f"SN presentes nos dois conjuntos: {train_sn &amp; test_sn}")\n\nprint("\\nClasses no treino:")\nprint(y.iloc[train_index].value_counts().sort_index())\n\nprint("\\nClasses no teste:")\nprint(y.iloc[test_index].value_counts().sort_index())', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x02K\x00\x00\x01D\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
