		<properties node_id="13" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x91\x00\x00\x00\x05\x00\x00\x05q\x00\x00\x03r\x00\x00\x00\x92\x00\x00\x00#\x00\x00\x05p\x00\x00\x03q\x00\x00\x00\x00\x00\x00\x00\x00\x06\xab\x00\x00\x00\x92\x00\x00\x00#\x00\x00\x05p\x00\x00\x03q', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import sys\nsys.path.insert(0, r"C:\\Users\\celio\\AppData\\Roaming\\Python\\Python312\\site-packages")\n\nimport numpy as np\nfrom Orange.data import Table\nfrom imblearn.over_sampling import SMOTE\n\nLIMIAR = 50\nMAX_MULTIPLICADOR = 5\nSEMENTE = 42\n\ny = np.asarray(in_data.Y).ravel()\nclasses, counts = np.unique(y, return_counts=True)\nantes = {int(c): int(n) for c, n in zip(classes, counts)}\n\nstrategy = {}\nfor class_value, count in zip(classes, counts):\n    if count &gt;= LIMIAR:\n        strategy[class_value] = int(count)\n    else:\n        strategy[class_value] = int(min(LIMIAR, count * MAX_MULTIPLICADOR))\n\nn_minoria = min(\n    count for count, alvo in zip(counts, strategy.values())\n    if alvo &gt; count\n)\nk = max(1, min(5, n_minoria - 1))\n\nX = np.array(in_data.X, dtype=float, copy=True)\ncol_median = np.nanmedian(X, axis=0)\nlinhas, cols = np.where(np.isnan(X))\nX[linhas, cols] = col_median[cols]\nX = np.nan_to_num(X, nan=0.0)\n\nX_novo, y_novo = SMOTE(\n    sampling_strategy=strategy,\n    k_neighbors=k,\n    random_state=SEMENTE,\n).fit_resample(X, y)\n\nn_orig = len(in_data)\nn_meta = len(in_data.domain.metas)\nmetas = np.empty((len(X_novo), n_meta), dtype=object)\nif n_meta:\n    metas[:n_orig] = np.asarray(in_data.metas)\n    metas[n_orig:] = None\n\n# Mesmo domínio do treino: o Random Forest e o Test and Score exigem isso.\nout_data = Table.from_numpy(\n    in_data.domain,\n    X_novo,\n    np.asarray(y_novo, dtype=float),\n    metas,\n)\n\nprint("k_neighbors:", k)\nprint("Antes:", antes)\nprint("Depois:", {int(c): int(n) for c, n in zip(*np.unique(out_data.Y, return_counts=True))})\nprint("Sinteticos:", len(out_data) - n_orig)', 'filename': None}], 'scriptText': 'import sys\nsys.path.insert(0, r"C:\\Users\\celio\\AppData\\Roaming\\Python\\Python312\\site-packages")\n\nimport numpy as np\nfrom Orange.data import Table\nfrom imblearn.over_sampling import SMOTE\n\nLIMIAR = 50\nMAX_MULTIPLICADOR = 5\nSEMENTE = 42\n\ny = np.asarray(in_data.Y).ravel()\nclasses, counts = np.unique(y, return_counts=True)\nantes = {int(c): int(n) for c, n in zip(classes, counts)}\n\nstrategy = {}\nfor class_value, count in zip(classes, counts):\n    if count &gt;= LIMIAR:\n        strategy[class_value] = int(count)\n    else:\n        strategy[class_value] = int(min(LIMIAR, count * MAX_MULTIPLICADOR))\n\nn_minoria = min(\n    count for count, alvo in zip(counts, strategy.values())\n    if alvo &gt; count\n)\nk = max(1, min(5, n_minoria - 1))\n\nX = np.array(in_data.X, dtype=float, copy=True)\ncol_median = np.nanmedian(X, axis=0)\nlinhas, cols = np.where(np.isnan(X))\nX[linhas, cols] = col_median[cols]\nX = np.nan_to_num(X, nan=0.0)\n\nX_novo, y_novo = SMOTE(\n    sampling_strategy=strategy,\n    k_neighbors=k,\n    random_state=SEMENTE,\n).fit_resample(X, y)\n\nn_orig = len(in_data)\nn_meta = len(in_data.domain.metas)\nmetas = np.empty((len(X_novo), n_meta), dtype=object)\nif n_meta:\n    metas[:n_orig] = np.asarray(in_data.metas)\n    metas[n_orig:] = None\n\n# Mesmo domínio do treino: o Random Forest e o Test and Score exigem isso.\nout_data = Table.from_numpy(\n    in_data.domain,\n    X_novo,\n    np.asarray(y_novo, dtype=float),\n    metas,\n)\n\nprint("k_neighbors:", k)\nprint("Antes:", antes)\nprint("Depois:", {int(c): int(n) for c, n in zip(*np.unique(out_data.Y, return_counts=True))})\nprint("Sinteticos:", len(out_data) - n_orig)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x02K\x00\x00\x01D\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
